# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# .env is gitignored and is never committed. Do not put real API keys in
# .env.example or any other tracked file.

# Fireworks inference endpoint (OpenAI-compatible).
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Fireworks model id. Note the slashes; these scripts pass it through an
# explicit client, so it works as-is.
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p2

# Your Fireworks API key. Get one at https://fireworks.ai.
FIREWORKS_API_KEY=your_fireworks_api_key_here
